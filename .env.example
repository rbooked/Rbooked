# --- Server ---
PORT=3000
# Public URL used in emails and the widget snippet (no trailing slash)
BASE_URL=http://localhost:3000
# Random secret used to sign login sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
# SQLite database file
DATABASE_PATH=./data/rbooked.db

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to run in "outbox" mode: emails are not sent, they are
# saved and viewable at /dev/outbox (handy for local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rbooked <reservations@example.com>"

# --- Stripe (use test keys first: sk_test_...) ---
# Leave empty to run billing in demo mode (no real charges, a "simulate" button appears).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring $20/month Price id from your Stripe dashboard.
# If empty, the price is created inline at checkout ($20.00 USD / month).
STRIPE_PRICE_ID=

# --- Background jobs ---
# How often to run reminder / no-show jobs, in seconds
JOB_INTERVAL_SECONDS=300
